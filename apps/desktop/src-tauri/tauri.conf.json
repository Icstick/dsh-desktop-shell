{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop Shell",
  "version": "0.1.0",
  "identifier": "dev.dsh.desktop-shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "shell",
        "title": "DSH Desktop Shell",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["shell"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis", "deb", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop shell",
    "longDescription": "Desktop shell for DeepSeek Harness: managed DSH runtimes, terminals, shared browser, and multi-profile switching (dsh-desktop-shell).",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}