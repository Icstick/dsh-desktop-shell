{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/fs/fs-roots-report.schema.json",
  "title": "FsRootsReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environmentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "roots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "repository",
              "dshHome",
              "cwd"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
