{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/fs/fs-read-file-request.schema.json",
  "title": "FsReadFileRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rootId",
    "relativePath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rootId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:[^:\\\\]|\\\\.)*$"
    }
  }
}
