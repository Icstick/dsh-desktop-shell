{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/webview/dsh-surface-policy.schema.json",
  "title": "DshSurfacePolicy",
  "description": "Fail-closed policy derived from a persisted fixed-loopback Environment before a DSH WebView may be created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentId",
    "surfaceLabel",
    "allowedOrigin",
    "sameOriginMainFrame",
    "externalHttpNavigation",
    "newWindow",
    "downloads",
    "permissions",
    "privilegedIpc",
    "domInjection",
    "rendererPatch",
    "automaticExternalOpen"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "surfaceLabel": {
      "const": "dsh-surface"
    },
    "allowedOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port"
      ],
      "properties": {
        "scheme": {
          "const": "http"
        },
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "sameOriginMainFrame": {
      "const": "allow"
    },
    "externalHttpNavigation": {
      "const": "delegate_with_user_action"
    },
    "newWindow": {
      "const": "deny"
    },
    "downloads": {
      "const": "deny"
    },
    "permissions": {
      "const": "deny"
    },
    "privilegedIpc": {
      "const": "denied"
    },
    "domInjection": {
      "const": "denied"
    },
    "rendererPatch": {
      "const": "denied"
    },
    "automaticExternalOpen": {
      "const": false
    }
  }
}
