{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/webview/dsh-surface-navigation-request.schema.json",
  "title": "DshSurfaceNavigationRequest",
  "description": "Evaluates one candidate URL against the policy derived from a persisted Environment. Policy fields are intentionally absent from caller input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentId",
    "candidateUrl",
    "navigationKind",
    "userGesture"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "candidateUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "navigationKind": {
      "enum": [
        "main_frame",
        "new_window",
        "download",
        "permission"
      ]
    },
    "userGesture": {
      "type": "boolean"
    }
  }
}
