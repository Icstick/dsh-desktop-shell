{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/protocol/terminal-capability.schema.json",
  "title": "TerminalCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "mode",
    "params"
  ],
  "properties": {
    "method": {
      "enum": [
        "create",
        "write",
        "resize",
        "close"
      ]
    },
    "mode": {
      "enum": [
        "human_surface",
        "agent_automation"
      ]
    },
    "params": {
      "type": "object"
    },
    "resourceId": {
      "type": "string"
    }
  }
}
