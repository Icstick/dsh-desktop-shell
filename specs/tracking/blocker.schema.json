{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/tracking/blocker.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "owner_role",
    "blocked_items",
    "details",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^BLOCK-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "resolved", "superseded"] },
    "owner_role": { "type": "string", "minLength": 1 },
    "blocked_items": {
      "type": "array",
      "items": { "type": "string", "pattern": "^WI-[A-Z0-9-]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "details": { "type": "string", "minLength": 1 },
    "resolution": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
