{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/runtime/managed-runtime-binding-report.schema.json",
  "title": "ManagedRuntimeBindingReport",
  "description": "Verified Surface binding of the exact generation. bootstrapUrl is the authenticated entry URL of the owned generation (dsh web token exchange) and travels only on this daemon channel - it is never part of the public status report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "port",
    "bootstrapUrl"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "bootstrapUrl": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/\\?token=[A-Za-z0-9_-]{43}$"
    }
  }
}
