{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/git/git-commit-report.schema.json",
  "title": "GitCommitReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "root",
    "operation",
    "path",
    "detail",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "operation": {
      "const": "commit"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "root",
        "detached",
        "clean",
        "truncated",
        "entries"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "root": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "clean": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "indexStatus",
              "worktreeStatus",
              "staged",
              "unstaged",
              "untracked"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "indexStatus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "worktreeStatus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "staged": {
                "type": "boolean"
              },
              "unstaged": {
                "type": "boolean"
              },
              "untracked": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
