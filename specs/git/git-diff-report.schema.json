{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/git/git-diff-report.schema.json",
  "title": "GitDiffReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "root",
    "scope",
    "text",
    "additions",
    "deletions",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "worktree",
        "staged"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "additions": {
      "type": "integer",
      "minimum": 0
    },
    "deletions": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
