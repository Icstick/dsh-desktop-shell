{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/git/git-commit-request.schema.json",
  "title": "GitCommitRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "message"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
