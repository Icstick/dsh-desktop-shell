{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/git/git-discard-request.schema.json",
  "title": "GitDiscardRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "path"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^-]"
    }
  }
}
