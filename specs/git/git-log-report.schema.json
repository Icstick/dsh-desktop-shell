{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/git/git-log-report.schema.json",
  "title": "GitLogReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "root",
    "entries",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hash",
          "author",
          "authoredAtUnixMs",
          "subject"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "minLength": 7,
            "maxLength": 64
          },
          "author": {
            "type": "string"
          },
          "authoredAtUnixMs": {
            "type": "integer",
            "minimum": 0
          },
          "subject": {
            "type": "string"
          }
        }
      }
    }
  }
}
