{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/terminal/terminal-create-request.schema.json",
  "title": "TerminalCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "cols",
    "rows"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "human_surface"
          }
        }
      },
      "then": {
        "properties": {
          "agent": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "agent_automation"
          }
        }
      },
      "then": {
        "required": [
          "agent"
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "human_surface",
        "agent_automation"
      ]
    },
    "cols": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500
    },
    "rows": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300
    },
    "shell": {
      "enum": [
        "default",
        "cmd",
        "powershell"
      ]
    },
    "cwd": {
      "type": "string",
      "maxLength": 1024
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "activationId",
        "generation",
        "scope"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "activationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "sessionId"
              ]
            },
            {
              "required": [
                "workspace"
              ]
            },
            {
              "required": [
                "domains"
              ]
            },
            {
              "required": [
                "resources"
              ]
            }
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "maxLength": 128
            },
            "workspace": {
              "type": "string",
              "maxLength": 128
            },
            "domains": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "resources": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
