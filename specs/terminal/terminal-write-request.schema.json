{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/terminal/terminal-write-request.schema.json",
  "title": "TerminalWriteRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^pty-[a-z0-9-]+$"
    },
    "data": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
