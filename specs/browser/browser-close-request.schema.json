{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/browser/browser-close-request.schema.json",
  "title": "BrowserCloseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^brw-[a-z0-9-]+$"
    }
  }
}