{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/browser/browser-snapshot-request.schema.json",
  "title": "BrowserSnapshotRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "snapshotMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^brw-[a-z0-9-]+$"
    },
    "snapshotMode": {
      "enum": [
        "text",
        "screenshot"
      ]
    }
  }
}