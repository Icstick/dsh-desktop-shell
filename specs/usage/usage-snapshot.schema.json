{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/usage/usage-snapshot.schema.json",
  "title": "UsageSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAtUnixMs",
    "records",
    "totals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAtUnixMs": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "./usage-record.schema.json"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "estimateCount"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "estimateCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
