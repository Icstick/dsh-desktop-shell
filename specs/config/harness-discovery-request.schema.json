{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/config/harness-discovery-request.schema.json",
  "title": "HarnessDiscoveryRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "explicitPaths",
    "includeDshPath",
    "includePath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "explicitPaths": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "includeDshPath": {
      "type": "boolean"
    },
    "includePath": {
      "type": "boolean"
    }
  }
}
