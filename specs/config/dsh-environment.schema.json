{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.local/specs/config/dsh-environment.schema.json",
  "title": "DshEnvironment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "label",
    "harness",
    "dshHome",
    "profile",
    "endpoint",
    "ownership"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path"
      ],
      "properties": {
        "mode": {
          "enum": [
            "repository",
            "executable",
            "command"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "dshHome": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "nodePath": {
      "description": "Absolute Node executable used only for a user-prebuilt Managed repository entrypoint. Desktop never installs Node or builds DSH.",
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          ]
        }
      }
    },
    "ownership": {
      "enum": [
        "managed",
        "attached"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoRestartOnCrash": {
          "type": "boolean"
        },
        "allowNativeAdapter": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["nodePath"]
      },
      "then": {
        "properties": {
          "harness": {
            "properties": {
              "mode": { "const": "repository" }
            }
          },
          "ownership": { "const": "managed" }
        }
      }
    }
  ]
}
